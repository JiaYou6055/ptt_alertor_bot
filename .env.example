# Telegram Bot Token (從 @BotFather 取得)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 爬蟲輪詢間隔秒數 (預設 300 秒 = 5 分鐘)
CHECK_INTERVAL_SECONDS=300

# 夜間模式設定 (預設開啟；凌晨 01:00 ~ 07:00 期間無聲推播且輪詢時間拉長為 30 分鐘 / 1800 秒)
NIGHT_MODE_ENABLED=true
NIGHT_START_HOUR=1
NIGHT_END_HOUR=7
NIGHT_CHECK_INTERVAL_SECONDS=1800

# 精簡版訊息通知 (預設 true；若要改回原本長版可設為 false)
COMPACT_NOTIFICATION=true

# 超級管理員 ID (設定主人的 Telegram Chat ID；擁有管理 /allow 和 /deny 白名單的權限)
ADMIN_USER_ID=

# 使用者白名單限制 (多個 ID 請用逗號分隔，如 ALLOWED_USER_IDS=12345678,87654321；若留空則允許所有人存取)
ALLOWED_USER_IDS=

# 資料庫路徑
DB_PATH=ptt_alert.db
